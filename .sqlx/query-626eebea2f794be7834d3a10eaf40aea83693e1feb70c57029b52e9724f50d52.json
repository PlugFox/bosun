  "query": "SELECT f.tool_call_id, f.path, f.kind\n               FROM file_touch f\n               JOIN tool_call t ON t.id = f.tool_call_id\n               JOIN message m ON m.id = t.message_id\n               WHERE m.ts_ms >= ? AND m.ts_ms < ?\n               ORDER BY f.tool_call_id, f.path, f.kind",
